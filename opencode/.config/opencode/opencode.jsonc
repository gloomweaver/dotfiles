{
  "$schema": "https://opencode.ai/config.json",

  // Default interactive model and agent
  "model": "ollama/flint:40b",
  "default_agent": "build",

  // Automatic compaction tuning for long sessions.
  // keep.tokens is the recent conversation kept beside the summary; buffer is the
  // extra headroom (in tokens) left free in the context window so compaction starts
  // before the conversation actually overflows.
  "compaction": {
    "auto": true,
    "keep": { "tokens": 6000 },
    // buffer is the share of the context window kept free; compaction starts once the
    // conversation fills the rest. Flint advertises 131072, and the gateway rejects input
    // above 131072 - 8192 output - 4096 template = 118784. Compact at 60% full (~78.6k) so
    // there is ample room below the cutoff for one large turn (doc fetch, skill load).
    "buffer": "40%"
  },

  // Disable global models.dev catalog plugin to keep model selector lists clean
  "plugins": [
    "-opencode.models.dev",
    "/Users/kirillkhramkov/.config/opencode/spillover"
  ],

  // =========================================================================
  // PROVIDER CONFIGURATIONS
  // =========================================================================
  "providers": {
    // -----------------------------------------------------------------------
    // OLLAMA (LOCAL AI)
    // -----------------------------------------------------------------------
    "ollama": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "Ollama (local)",
      "settings": {
        // Use 127.0.0.1 instead of localhost to prevent IPv6 DNS hangs
        "baseURL": "http://127.0.0.1:11434/v1",
        "encoding": "none",
        "headerTimeout": 240000
      },
      "models": {
        // --- PRIMARY CODING WORKHORSE ---
        "flint:40b": {
          "name": "Flint 40B (MoE)",
          "limit": {
            // Ollama runs this model at num_ctx 262144 (verified: still 100% GPU / 22 GB on
            // 48 GB — compact KV cache, so context is effectively free). We advertise 131072
            // and set the gateway budget to match. Usable input = 131072 - 16384 output - 4096
            // template reserve = 110592, far above the ~23k fixed overhead of a session.
            "context": 131072,
            // Flint reasons before answering and those reasoning tokens count against this
            // budget. 8192 was exhausted in real use ("still truncated after two output token
            // limit continuations"), so it is 16384. Keep in sync with spillover/gateway.mjs.
            "output": 16384
          }
        },

        // --- FAST BUILD/EDIT WORKHORSE (non-reasoning, ~7-14x faster than Flint) ---
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B (MoE)",
          "limit": {
            // 30.5B params / ~3.3B active MoE, 262144 num_ctx like Flint. Non-reasoning, so no
            // "reasoning tokens exhaust the budget" failure mode — a moderate output ceiling is
            // plenty. Measured 82 tok/s gen, 175 tok/s prefill; edits in ~5.6s vs Flint's 40-80s.
            "context": 131072,
            "output": 8192
          }
        },

        // --- BACKGROUND UTILITIES (COMPACTION/TITLES/SUMMARIES) ---
        "llama3.2:3b": {
          "name": "Llama 3.2 3B",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },

    // Local-first build with a larger advertised window for cloud overflow.
    // The plugin supplies the root session's privacy policy and active cloud key.
    "local-router": {
      "name": "Local-first + Cloud Overflow",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:11435/v1",
        "apiKey": "{file:./spillover/token}",
        "encoding": "none",
        "headerTimeout": 240000
      },
      "models": {
        "build": {
          "name": "Flint 40B → Cloud when busy/large",
          "modelID": "flint:40b",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "compatibility": { "maxTokensField": "max_tokens" },
          "limit": { "context": 131072, "output": 8192 }
        }
      }
    },

    // -----------------------------------------------------------------------
    // OPENROUTER (WITH AUTOMATIC FALLBACK ROUTERS)
    // -----------------------------------------------------------------------
    "openrouter": {
      "name": "OpenRouter (Clean)",
      "package": "@opencode/ai/providers/openrouter",
      "models": {
        // ===================================================================
        // FALLBACK ROUTERS (Auto-Failover via OpenRouter 'models' array)
        // -------------------------------------------------------------------
        // The `modelID` is the primary model sent as `model`; `settings.models`
        // is the ordered fallback array OpenRouter tries on error. These are
        // passed through providerOptions so they reach the request body, which
        // is why they must live under `settings`, NOT `body`.
        // ===================================================================
        // Plan Router: Claude Sonnet 5.5 -> GPT 6.1 Sol -> DeepSeek V4 Pro
        "router/plan": {
          "name": "Plan Fallback Router (Sonnet -> Sol -> DeepSeek)",
          "modelID": "anthropic/claude-sonnet-5.5",
          "settings": {
            "models": [
              "anthropic/claude-sonnet-5.5",
              "openai/gpt-6.1-sol",
              "deepseek/deepseek-v4-pro-0813"
            ]
          }
        },

        // Build Router: DeepSeek V4 Pro -> Kimi K2.7 Code -> Claude Sonnet
        // (OpenRouter limits a router's fallback list to a maximum of 3 models.)
        "router/build": {
          "name": "Build Fallback Router (DeepSeek -> Kimi -> Sonnet)",
          "modelID": "deepseek/deepseek-v4-pro-0813",
          "settings": {
            "models": [
              "deepseek/deepseek-v4-pro-0813",
              "moonshotai/kimi-k2.7-code",
              "anthropic/claude-sonnet-5.5"
            ]
          }
        },

        // ===================================================================
        // DIRECT STANDALONE MODELS
        // ===================================================================
        "anthropic/claude-sonnet-5.5": {
          "name": "Claude Sonnet 5.5"
        },
        "openai/gpt-6.1-sol": {
          "name": "GPT 6.1 Sol"
        },
        "deepseek/deepseek-v4-pro-0813": {
          "name": "DeepSeek V4 Pro"
        },
        "moonshotai/kimi-k2.7-code": {
          "name": "Kimi K2.7 Code"
        },
        "google/gemini-3.8-flash": {
          "name": "Gemini 3.8 Flash"
        },
        "~z-ai/glm-flash-latest": {
          "name": "GLM Flash Latest"
        }
      }
    }
  },

  // =========================================================================
  // AGENT PRESETS (CLOUD, MIXED, LOCAL)
  // =========================================================================
  "agents": {
    // -----------------------------------------------------------------------
    // 1. CLOUD PRESET (Backed by Automatic Fallback Routers)
    // -----------------------------------------------------------------------
    "plan-cloud": {
      "description": "Cloud Planning: Auto-fallback (Sonnet 5.5 -> GPT 6.1 -> DeepSeek)",
      "mode": "primary",
      "model": "openrouter/router/plan",
      "permissions": [
        // Read-only except the plan folder. `edit` doesn't cover shell, so deny it too.
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        // Plan folder: relative form (when it's inside the Location) and absolute form (when external).
        { "action": "edit", "resource": ".opencode/plan/*", "effect": "allow" },
        { "action": "edit", "resource": "~/.opencode/plan/*", "effect": "allow" },
        // Read-only shell: let the plan agent check the toolchain without writing.
        { "action": "shell", "resource": "which *", "effect": "allow" },
        { "action": "shell", "resource": "command -v *", "effect": "allow" },
        { "action": "shell", "resource": "* --version *", "effect": "allow" },
        { "action": "shell", "resource": "* --version", "effect": "allow" },
        { "action": "shell", "resource": "cargo version *", "effect": "allow" },
        { "action": "shell", "resource": "rustc --version *", "effect": "allow" },
        { "action": "shell", "resource": "cargo clippy --version *", "effect": "allow" },
        { "action": "shell", "resource": "ls *", "effect": "allow" },
        { "action": "shell", "resource": "find *", "effect": "allow" },
        { "action": "shell", "resource": "git status *", "effect": "allow" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git log *", "effect": "allow" },
        { "action": "shell", "resource": "git branch *", "effect": "allow" },
        { "action": "shell", "resource": "git remote *", "effect": "allow" },
        { "action": "shell", "resource": "git --version *", "effect": "allow" }
      ]
    },
    "build-cloud": {
      "description": "Cloud Build: Auto-fallback (DeepSeek -> Kimi -> Sonnet)",
      "mode": "primary",
      "model": "openrouter/router/build"
    },

    // -----------------------------------------------------------------------
    // 2. MIXED PRESET (Cloud Planning with Fallback + Free Local Execution)
    // -----------------------------------------------------------------------
    "plan-mixed": {
      "description": "Mixed Planning: Cloud fallback (Sonnet -> Sol -> DeepSeek)",
      "mode": "primary",
      "model": "openrouter/router/plan",
      "system": "Produce a concrete, file-by-file implementation plan that a smaller local executor can follow. For each step give the target file path, the exact change to make (short code snippets where useful), and an acceptance check. Keep every step atomic and unambiguous so a less capable model does not have to re-derive decisions.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        // Plan folder: relative form (when it's inside the Location) and absolute form (when external).
        { "action": "edit", "resource": ".opencode/plan/*", "effect": "allow" },
        { "action": "edit", "resource": "~/.opencode/plan/*", "effect": "allow" },
        // Read-only shell: let the plan agent check the toolchain without writing.
        { "action": "shell", "resource": "which *", "effect": "allow" },
        { "action": "shell", "resource": "command -v *", "effect": "allow" },
        { "action": "shell", "resource": "* --version *", "effect": "allow" },
        { "action": "shell", "resource": "* --version", "effect": "allow" },
        { "action": "shell", "resource": "cargo version *", "effect": "allow" },
        { "action": "shell", "resource": "rustc --version *", "effect": "allow" },
        { "action": "shell", "resource": "cargo clippy --version *", "effect": "allow" },
        { "action": "shell", "resource": "ls *", "effect": "allow" },
        { "action": "shell", "resource": "find *", "effect": "allow" },
        { "action": "shell", "resource": "git status *", "effect": "allow" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git log *", "effect": "allow" },
        { "action": "shell", "resource": "git branch *", "effect": "allow" },
        { "action": "shell", "resource": "git remote *", "effect": "allow" },
        { "action": "shell", "resource": "git --version *", "effect": "allow" }
      ]
    },
    "build-mixed": {
      "description": "Mixed Build: Local-first Flint 40B, cloud overflow when busy/large",
      "mode": "primary",
      "model": "local-router/build"
    },

    // -----------------------------------------------------------------------
    // 3. PURELY LOCAL PRESET: 100% Offline, Private, Zero-Cost
    // -----------------------------------------------------------------------
    "plan-local": {
      "description": "Local Planning: Local thinking & reasoning (Flint 40B)",
      "mode": "primary",
      "model": "ollama/flint:40b",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        // Plan folder: relative form (when it's inside the Location) and absolute form (when external).
        { "action": "edit", "resource": ".opencode/plan/*", "effect": "allow" },
        { "action": "edit", "resource": "~/.opencode/plan/*", "effect": "allow" },
        // Read-only shell: let the plan agent check the toolchain without writing.
        { "action": "shell", "resource": "which *", "effect": "allow" },
        { "action": "shell", "resource": "command -v *", "effect": "allow" },
        { "action": "shell", "resource": "* --version *", "effect": "allow" },
        { "action": "shell", "resource": "* --version", "effect": "allow" },
        { "action": "shell", "resource": "cargo version *", "effect": "allow" },
        { "action": "shell", "resource": "rustc --version *", "effect": "allow" },
        { "action": "shell", "resource": "cargo clippy --version *", "effect": "allow" },
        { "action": "shell", "resource": "ls *", "effect": "allow" },
        { "action": "shell", "resource": "find *", "effect": "allow" },
        { "action": "shell", "resource": "git status *", "effect": "allow" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git log *", "effect": "allow" },
        { "action": "shell", "resource": "git branch *", "effect": "allow" },
        { "action": "shell", "resource": "git remote *", "effect": "allow" },
        { "action": "shell", "resource": "git --version *", "effect": "allow" }
      ]
    },
    "build-local": {
      "description": "Local Build: Local coding & tool execution (Flint 40B)",
      "mode": "primary",
      "model": "ollama/flint:40b"
    },

    // -----------------------------------------------------------------------
    // DEFAULT ALIASES ('build' and 'plan' map to Local by default)
    // -----------------------------------------------------------------------
    "build": {
      "model": "ollama/flint:40b"
    },
    "plan": {
      "model": "ollama/flint:40b",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        // Plan folder: relative form (when it's inside the Location) and absolute form (when external).
        { "action": "edit", "resource": ".opencode/plan/*", "effect": "allow" },
        { "action": "edit", "resource": "~/.opencode/plan/*", "effect": "allow" },
        // Read-only shell: let the plan agent check the toolchain without writing.
        { "action": "shell", "resource": "which *", "effect": "allow" },
        { "action": "shell", "resource": "command -v *", "effect": "allow" },
        { "action": "shell", "resource": "* --version *", "effect": "allow" },
        { "action": "shell", "resource": "* --version", "effect": "allow" },
        { "action": "shell", "resource": "cargo version *", "effect": "allow" },
        { "action": "shell", "resource": "rustc --version *", "effect": "allow" },
        { "action": "shell", "resource": "cargo clippy --version *", "effect": "allow" },
        { "action": "shell", "resource": "ls *", "effect": "allow" },
        { "action": "shell", "resource": "find *", "effect": "allow" },
        { "action": "shell", "resource": "git status *", "effect": "allow" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git log *", "effect": "allow" },
        { "action": "shell", "resource": "git branch *", "effect": "allow" },
        { "action": "shell", "resource": "git remote *", "effect": "allow" },
        { "action": "shell", "resource": "git --version *", "effect": "allow" }
      ]
    },

    // -----------------------------------------------------------------------
    // SHARED WORKERS: local-first with cloud overflow only in cloud/mixed roots.
    // -----------------------------------------------------------------------
    "explore": {
      "model": "ollama/qwen3-coder:30b"
    },
    "general": {
      "model": "ollama/flint:40b"
    },
    "summary": {
      "model": "ollama/llama3.2:3b"
    },
    "title": {
      "model": "ollama/llama3.2:3b"
    }
  }
}
